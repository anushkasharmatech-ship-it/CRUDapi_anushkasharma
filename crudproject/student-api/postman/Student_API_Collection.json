          "name": "8. Verify Student Deletion",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/getById?id={{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deleted student cannot be retrieved successfully', function () {",
                  "    pm.expect(pm.response.code).to.not.eql(200);",
                  "});",
                  "pm.test('Response is not the deleted student record', function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('Postman Student Updated');",
                  "});"
                ]
              }
            }
