        {
          "name": "1. Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"postman.student@example.com\",\n  \"age\": 21,\n  \"teacher\": { \"id\": 1 }\n}"
            },
            "url": "{{baseUrl}}/api/students"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response body is valid JSON', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "});",
                  "pm.test('Created student contains a valid ID', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.id).to.be.above(0);",
                  "    pm.collectionVariables.set('studentId', String(json.id));",
                  "});",
                  "pm.test('Created student has the submitted fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('Postman Student');",
                  "    pm.expect(json.email).to.eql('postman.student@example.com');",
                  "    pm.expect(json.age).to.eql(21);",
                  "    pm.expect(json.teacher).to.be.an('object');",
                  "    pm.expect(json.teacher.id).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get All Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response body is a valid JSON array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});",
                  "pm.test('Created student is present in the list', function () {",
                  "    const json = pm.response.json();",
                  "    const studentId = Number(pm.collectionVariables.get('studentId'));",
                  "    const found = json.find(function (s) { return s.id === studentId; });",
                  "    pm.expect(found).to.exist;",
                  "    pm.expect(found.name).to.eql('Postman Student');",
                  "});"
                ]
              }
            }
          ]
        },
